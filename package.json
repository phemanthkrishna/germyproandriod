{
  "name": "getmypro",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --mode customer",
    "dev:worker": "vite --mode worker",
    "dev:store": "vite --mode store",
    "dev:admin": "vite --mode admin",
    "build": "tsc && vite build --mode customer",
    "build:customer": "tsc && vite build --mode customer",
    "build:worker": "tsc && vite build --mode worker",
    "build:store": "tsc && vite build --mode store",
    "build:admin": "tsc && vite build --mode admin",
    "preview": "vite preview",
    "sync:customer": "npm run build:customer && cd capacitor-customer && npx cap sync",
    "sync:worker": "npm run build:worker && cd capacitor-worker && npx cap sync",
    "sync:store": "npm run build:store && cd capacitor-store && npx cap sync",
    "open:customer": "cd capacitor-customer && npx cap open android",
    "open:worker": "cd capacitor-worker && npx cap open android",
    "open:store": "cd capacitor-store && npx cap open android",
    "icons": "node scripts/generate-icons.js"
  },
  "dependencies": {
    "@capacitor-firebase/authentication": "^8.1.0",
    "@capacitor/core": "^8.3.0",
    "@hookform/resolvers": "^3.9.0",
    "@react-google-maps/api": "^2.20.8",
    "@supabase/supabase-js": "^2.45.0",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.1",
    "firebase": "^9.23.0",
    "lucide-react": "^0.439.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-hook-form": "^7.53.0",
    "react-router-dom": "^6.26.2",
    "sonner": "^1.5.0",
    "tailwind-merge": "^2.5.2",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.45",
    "sharp": "^0.33.5",
    "supabase": "^2.82.0",
    "tailwindcss": "^3.4.11",
    "typescript": "^5.5.3",
    "vite": "^5.4.2"
  }
